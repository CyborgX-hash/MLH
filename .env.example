# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=decitrace
POSTGRES_PASSWORD=decitrace
POSTGRES_DB=decitrace
POSTGRES_PORT=5433

# --- Backend ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://decitrace:decitrace@localhost:5433/decitrace
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173"]
# Personal access token with public read scope; needed from the GitHub milestone on (60 req/h without it)
GITHUB_TOKEN=
# OpenAI-compatible endpoint serving an open-weight model (Ollama by default)
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:1.5b

# --- Frontend (Vite) ---
# Leave empty to use the Vite dev proxy; set to the backend URL for a separate deployment
VITE_API_BASE_URL=
VITE_BACKEND_PROXY_TARGET=http://localhost:8000

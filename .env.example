# Copy to .env and adjust. Never commit .env.

# --- PostgreSQL (docker compose) ---
POSTGRES_USER=decitrace
POSTGRES_PASSWORD=decitrace
POSTGRES_DB=decitrace
POSTGRES_PORT=5433

# --- Backend ---
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://decitrace:decitrace@localhost:5433/decitrace
# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173"]
# Personal access token with public read scope; needed from the GitHub milestone on (60 req/h without it)
GITHUB_TOKEN=
# Required to submit decision candidates or rebuild indexes over HTTP (X-DeciTrace-Admin-Token header).
# Leave empty to keep those endpoints disabled. Use a long random value, e.g. `openssl rand -hex 32`.
DECITRACE_ADMIN_TOKEN=

# AI: any OpenAI-compatible endpoint serving open-weight models (Ollama by default)
AI_PROVIDER=ollama
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen3:8b
# Only needed for hosted providers; never sent to the browser
AI_API_KEY=
# Embedding model for pgvector search; leave empty to use full-text search only
AI_EMBED_MODEL=qwen3-embedding:0.6b
AI_TIMEOUT=180
# Optional provider-specific chat options (JSON). For OpenRouter reasoning models such as Qwen3.x:
# AI_EXTRA_BODY={"reasoning": {"enabled": false}}
AI_EXTRA_BODY={}

# --- Frontend (Vite) ---
# Leave empty to use the Vite dev proxy; set to the backend URL for a separate deployment
VITE_API_BASE_URL=
VITE_BACKEND_PROXY_TARGET=http://localhost:8000
